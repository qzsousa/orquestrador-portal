# Estado de execucao (recuperavel, mas local e derivado)
.state/

# Worktrees das tarefas. Fica FORA do repo de produto de proposito: o worktree
# e um clone de trabalho, nao fonte. Nunca versionar.
worktrees/
.state-backup/

# Worktrees que o E2E cria dentro deste proprio repo (o E2E roda com
# worktreesDir apontando para cá). São repos git aninhados: se entrarem no
# índice, o git passa a registrá-los como gitlink e o commit fica inservível.
orq-worktrees/

# Logs de execucao
logs/

# Credenciais. NUNCA versionar. Ver README (Trello).
.env
.env.*
!.env.example

node_modules/
*.log
.DS_Store